          "hex": "#f8fafc"
        }
      },
      "100": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9450980392156862, 0.9607843137254902, 0.9764705882352941],
          "alpha": 1,
          "hex": "#f1f5f9"
        }
      },
      "200": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.8862745098039215, 0.9098039215686274, 0.9411764705882353],
          "alpha": 1,
          "hex": "#e2e8f0"
        }
      },
      "700": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2, 0.2549019607843137, 0.3333333333333333],
          "alpha": 1,
          "hex": "#334155"
        }
      },
      "900": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.058823529411764705, 0.09019607843137255, 0.16470588235294117],
