          "alpha": 1,
          "hex": "#4f46e5"
        }
      },
      "700": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2627450980392157, 0.2196078431372549, 0.792156862745098],
          "alpha": 1,
          "hex": "#4338ca"
        }
      }
    },
