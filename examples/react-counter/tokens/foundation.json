  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } },
    "8": { "$value": { "value": 32, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": { "value": 12, "unit": "px" } },
    "panel": { "$value": { "value": 24, "unit": "px" } },
    "pill": { "$value": { "value": 999, "unit": "px" } }
  },
  "motion": {
    "fast": {
      "$type": "duration",
      "$value": { "value": 160, "unit": "ms" }
    }
  },
  "counter": {
    "step": {
      "$type": "number",
      "$description": "The amount added or removed by each counter action.",
      "$value": 1
    },
    "minimum": { "$type": "number", "$value": -9 },
    "maximum": { "$type": "number", "$value": 9 }
  }
}
