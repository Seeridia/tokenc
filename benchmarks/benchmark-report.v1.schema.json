{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Seeridia/tokenc/main/benchmarks/benchmark-report.v1.schema.json",
  "title": "tokenc compiler benchmark report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "suite",
    "generatedAt",
    "source",
    "environment",
    "methodology",
    "cases"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/Seeridia/tokenc/main/benchmarks/benchmark-report.v1.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "tokenc-compiler" },
        "version": { "const": 1 }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "dirty": { "type": "boolean" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "v8",
        "platform",
        "arch",
        "cpuModel",
        "logicalCores",
        "totalMemoryBytes"
      ],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "v8": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "cpuModel": { "type": "string", "minLength": 1 },
        "logicalCores": { "type": "integer", "minimum": 1 },
        "totalMemoryBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "warmupRuns",
        "sampleRuns",
        "memorySampleRuns",
        "percentileMethod",
        "clock",
        "concurrency",
        "fixturePreparationIncluded",
        "ioIncluded",
        "timingIsolation",
        "memoryIsolation"
      ],
      "properties": {
        "profile": { "enum": ["baseline", "quick"] },
        "warmupRuns": { "type": "integer", "minimum": 0 },
        "sampleRuns": { "type": "integer", "minimum": 1 },
        "memorySampleRuns": { "type": "integer", "minimum": 0 },
        "percentileMethod": { "const": "linear-r7" },
        "clock": { "const": "performance.now" },
        "concurrency": { "const": 1 },
        "fixturePreparationIncluded": { "const": false },
        "ioIncluded": { "const": false },
        "timingIsolation": { "const": "one-process-per-case" },
        "memoryIsolation": { "const": "one-process-per-sample" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "nonNegativeNumber": { "type": "number", "minimum": 0 },
    "nullableNonNegativeInteger": {
      "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
    },
    "diagnostics": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "min", "p50", "p95", "max"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "min": { "$ref": "#/$defs/nonNegativeNumber" },
        "p50": { "$ref": "#/$defs/nonNegativeNumber" },
        "p95": { "$ref": "#/$defs/nonNegativeNumber" },
        "max": { "$ref": "#/$defs/nonNegativeNumber" }
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parse", "link", "graph", "check", "resolve", "emit", "total"],
      "properties": {
        "parse": { "$ref": "#/$defs/nonNegativeNumber" },
        "link": { "$ref": "#/$defs/nonNegativeNumber" },
        "graph": { "$ref": "#/$defs/nonNegativeNumber" },
        "check": { "$ref": "#/$defs/nonNegativeNumber" },
        "resolve": { "$ref": "#/$defs/nonNegativeNumber" },
        "emit": { "$ref": "#/$defs/nonNegativeNumber" },
        "total": { "$ref": "#/$defs/nonNegativeNumber" }
      }
    },
    "stageDistributions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parse", "link", "graph", "check", "resolve", "emit", "total"],
      "properties": {
        "parse": { "$ref": "#/$defs/distribution" },
        "link": { "$ref": "#/$defs/distribution" },
        "graph": { "$ref": "#/$defs/distribution" },
        "check": { "$ref": "#/$defs/distribution" },
        "resolve": { "$ref": "#/$defs/distribution" },
        "emit": { "$ref": "#/$defs/distribution" },
        "total": { "$ref": "#/$defs/distribution" }
      }
    },
    "contextCycles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateRegions",
        "relevantDimensions",
        "estimatedProjections",
        "estimateSaturated",
        "enumeratedProjections",
        "earlyExits",
        "limitHits"
      ],
      "properties": {
        "candidateRegions": { "type": "integer", "minimum": 0 },
        "relevantDimensions": { "type": "integer", "minimum": 0 },
        "estimatedProjections": { "type": "integer", "minimum": 0 },
        "estimateSaturated": { "type": "boolean" },
        "enumeratedProjections": { "type": "integer", "minimum": 0 },
        "earlyExits": { "type": "integer", "minimum": 0 },
        "limitHits": { "type": "integer", "minimum": 0 }
      }
    },
    "changeIntelligenceStages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotConstruction",
        "impactTraversal",
        "backendPreparation",
        "reportSerialization"
      ],
      "properties": {
        "snapshotConstruction": { "$ref": "#/$defs/nonNegativeNumber" },
        "impactTraversal": { "$ref": "#/$defs/nonNegativeNumber" },
        "backendPreparation": { "$ref": "#/$defs/nonNegativeNumber" },
        "reportSerialization": { "$ref": "#/$defs/nonNegativeNumber" }
      }
    },
    "changeIntelligenceCounters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseTokens",
        "headTokens",
        "changedTokens",
        "directlyAffectedTokens",
        "indirectlyAffectedTokens",
        "backendPlans",
        "reportEntries",
        "reportBytes"
      ],
      "properties": {
        "baseTokens": { "type": "integer", "minimum": 0 },
        "headTokens": { "type": "integer", "minimum": 0 },
        "changedTokens": { "type": "integer", "minimum": 0 },
        "directlyAffectedTokens": { "type": "integer", "minimum": 0 },
        "indirectlyAffectedTokens": { "type": "integer", "minimum": 0 },
        "backendPlans": { "type": "integer", "minimum": 0 },
        "reportEntries": { "type": "integer", "minimum": 0 },
        "reportBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "changeIntelligence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stagesMs", "counters"],
      "properties": {
        "stagesMs": { "$ref": "#/$defs/changeIntelligenceStages" },
        "counters": { "$ref": "#/$defs/changeIntelligenceCounters" }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "references",
        "contexts",
        "affectedTokens",
        "checkedTokens",
        "resolverComputations",
        "changedTokens",
        "recomputedTokens",
        "graphTouchedNodes",
        "graphTouchedEdges",
        "outputFiles",
        "outputBytes",
        "diagnostics",
        "contextCycles"
      ],
      "properties": {
        "tokens": { "type": "integer", "minimum": 0 },
        "references": { "type": "integer", "minimum": 0 },
        "contexts": { "type": "integer", "minimum": 0 },
        "affectedTokens": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "checkedTokens": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "resolverComputations": { "type": "integer", "minimum": 0 },
        "changedTokens": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "recomputedTokens": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "graphTouchedNodes": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "graphTouchedEdges": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "outputFiles": { "type": "integer", "minimum": 0 },
        "outputBytes": { "type": "integer", "minimum": 0 },
        "diagnostics": { "$ref": "#/$defs/diagnostics" },
        "contextCycles": { "$ref": "#/$defs/contextCycles" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "sha256", "files", "bytes", "description"],
      "properties": {
        "kind": { "enum": ["ecosystem", "repository", "synthetic"] },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "files": { "type": "integer", "minimum": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "description": { "type": "string", "minLength": 1 },
        "parameters": {
          "type": "object",
          "additionalProperties": { "type": ["boolean", "number", "string"] }
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "license"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "license": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "cacheState", "outputTarget", "ioIncluded"],
      "properties": {
        "kind": {
          "enum": [
            "change-intelligence-high-fan-out",
            "change-intelligence-one-file-edit",
            "change-intelligence-report-serialization",
            "change-intelligence-unchanged",
            "cold-compile",
            "editor-cancellation",
            "editor-cold-start",
            "editor-high-fan-out",
            "editor-invalid-recovery",
            "editor-one-file-update",
            "incremental-update"
          ]
        },
        "cacheState": { "enum": ["compiler-cold-runtime-warm", "initialized-session"] },
        "outputTarget": { "enum": ["backend-plan", "css", "none"] },
        "ioIncluded": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compilationSuccess", "matchesExpected", "semanticSha256", "diagnostics"],
      "properties": {
        "compilationSuccess": { "type": "boolean" },
        "matchesExpected": { "const": true },
        "semanticSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "diagnostics": { "$ref": "#/$defs/diagnostics" }
      }
    },
    "timeSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "wallMs", "stagesMs", "counters"],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "wallMs": { "$ref": "#/$defs/nonNegativeNumber" },
        "stagesMs": { "$ref": "#/$defs/stages" },
        "counters": { "$ref": "#/$defs/counters" },
        "changeIntelligence": {
          "oneOf": [{ "$ref": "#/$defs/changeIntelligence" }, { "type": "null" }]
        }
      }
    },
    "memorySample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "baselineRssBytes",
        "preMaxRssBytes",
        "peakRssBytes",
        "peakIncreaseBytes"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "baselineRssBytes": { "type": "integer", "minimum": 0 },
        "preMaxRssBytes": { "type": "integer", "minimum": 0 },
        "peakRssBytes": { "type": "integer", "minimum": 0 },
        "peakIncreaseBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "group",
        "fixture",
        "operation",
        "validation",
        "timeSamples",
        "memorySamples",
        "summary"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "group": {
          "enum": [
            "change-intelligence",
            "deep",
            "dtcg-examples",
            "editor-loop",
            "fan-out",
            "incremental",
            "multidimensional-context",
            "override-heavy",
            "representative",
            "small",
            "sparse-context",
            "wide"
          ]
        },
        "fixture": { "$ref": "#/$defs/fixture" },
        "operation": { "$ref": "#/$defs/operation" },
        "validation": { "$ref": "#/$defs/validation" },
        "timeSamples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/timeSample" }
        },
        "memorySamples": {
          "type": "array",
          "items": { "$ref": "#/$defs/memorySample" }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wallMs", "stagesMs", "peakRssBytes", "peakIncreaseBytes"],
          "properties": {
            "wallMs": { "$ref": "#/$defs/distribution" },
            "stagesMs": { "$ref": "#/$defs/stageDistributions" },
            "peakRssBytes": {
              "oneOf": [{ "$ref": "#/$defs/distribution" }, { "type": "null" }]
            },
            "peakIncreaseBytes": {
              "oneOf": [{ "$ref": "#/$defs/distribution" }, { "type": "null" }]
            },
            "changeIntelligence": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["stagesMs", "counters"],
                  "properties": {
                    "stagesMs": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "snapshotConstruction",
                        "impactTraversal",
                        "backendPreparation",
                        "reportSerialization"
                      ],
                      "properties": {
                        "snapshotConstruction": { "$ref": "#/$defs/distribution" },
                        "impactTraversal": { "$ref": "#/$defs/distribution" },
                        "backendPreparation": { "$ref": "#/$defs/distribution" },
                        "reportSerialization": { "$ref": "#/$defs/distribution" }
                      }
                    },
                    "counters": { "$ref": "#/$defs/changeIntelligenceCounters" }
                  }
                },
                { "type": "null" }
              ]
            }
          }
        }
      }
    }
  }
}
