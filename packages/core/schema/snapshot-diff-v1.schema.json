{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokenc.dev/schemas/snapshot-diff-v1.schema.json",
  "title": "tokenc Snapshot Diff v1",
  "description": "Stable machine contract for semantic comparison of two Compilation snapshots.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "base",
    "head",
    "coverage",
    "changes",
    "renameCandidates",
    "impact",
    "backends",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "status": { "enum": ["complete", "incomplete"] },
    "base": { "$ref": "#/$defs/snapshotIdentity" },
    "head": { "$ref": "#/$defs/snapshotIdentity" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/change" }
    },
    "renameCandidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/renameCandidate" }
    },
    "impact": { "$ref": "#/$defs/impact" },
    "backends": {
      "type": "array",
      "items": { "$ref": "#/$defs/backendChange" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/sidedDiagnostic" }
    }
  },
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "column", "offset", "length"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "offset": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 0 }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "range"],
      "properties": {
        "document": { "type": "string", "minLength": 1 },
        "range": { "$ref": "#/$defs/range" },
        "anchor": { "$ref": "#/$defs/jsonValue" },
        "excerpt": { "type": "string" }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "default", "values"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "default": { "type": "string" },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "clauses", "key"],
      "properties": {
        "domain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dimensions", "key"],
          "properties": {
            "dimensions": {
              "type": "array",
              "items": { "$ref": "#/$defs/dimension" }
            },
            "key": { "type": "string" }
          }
        },
        "clauses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string" }
            }
          }
        },
        "key": { "type": "string" }
      }
    },
    "snapshotIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "sourceRevision", "configurationIdentity", "status"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "sourceRevision": { "type": "string", "minLength": 1 },
        "configurationIdentity": { "type": "string", "minLength": 1 },
        "status": { "enum": ["valid", "invalid"] }
      }
    },
    "omission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate", "reason"],
      "properties": {
        "predicate": { "$ref": "#/$defs/predicate" },
        "reason": {
          "enum": [
            "limit-exceeded",
            "invalid-base",
            "invalid-head",
            "configuration-unavailable",
            "backend-prepare-failed",
            "unsupported"
          ]
        },
        "detail": { "type": "string" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "compared", "omitted"],
      "properties": {
        "requested": {
          "type": "array",
          "items": { "$ref": "#/$defs/predicate" }
        },
        "compared": {
          "type": "array",
          "items": { "$ref": "#/$defs/predicate" }
        },
        "omitted": {
          "type": "array",
          "items": { "$ref": "#/$defs/omission" }
        }
      }
    },
    "tokenState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "$ref": "#/$defs/location" },
        "type": { "type": "string" },
        "expression": { "$ref": "#/$defs/jsonValue" },
        "resolvedValue": { "$ref": "#/$defs/jsonValue" },
        "metadata": { "$ref": "#/$defs/jsonValue" },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changeId", "kind", "token", "condition", "sides"],
      "properties": {
        "changeId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "kind": {
          "enum": [
            "added",
            "removed",
            "direct-value",
            "propagated-value",
            "type",
            "metadata",
            "dependency",
            "context-coverage"
          ]
        },
        "token": { "type": "string", "minLength": 1 },
        "condition": { "$ref": "#/$defs/predicate" },
        "sides": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["base", "head"] }
        },
        "before": { "$ref": "#/$defs/tokenState" },
        "after": { "$ref": "#/$defs/tokenState" }
      }
    },
    "renameCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "removed", "added", "ambiguity", "score", "evidence"],
      "properties": {
        "candidateId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "removed": { "type": "string", "minLength": 1 },
        "added": { "type": "string", "minLength": 1 },
        "ambiguity": { "enum": ["unambiguous", "ambiguous"] },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "equal-type",
              "equal-value",
              "equal-metadata",
              "equal-dependencies",
              "source-proximity"
            ]
          }
        }
      }
    },
    "impactEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "condition", "sides"],
      "properties": {
        "token": { "type": "string", "minLength": 1 },
        "condition": { "$ref": "#/$defs/predicate" },
        "sides": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["base", "head"] }
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "changed", "directlyAffected", "indirectlyAffected"],
      "properties": {
        "schemaVersion": { "const": "1" },
        "changed": { "type": "array", "items": { "$ref": "#/$defs/impactEntry" } },
        "directlyAffected": {
          "type": "array",
          "items": { "$ref": "#/$defs/impactEntry" }
        },
        "indirectlyAffected": {
          "type": "array",
          "items": { "$ref": "#/$defs/impactEntry" }
        }
      }
    },
    "backendChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changeId", "backendId", "kind", "identity"],
      "properties": {
        "changeId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "backendId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["symbol", "artifact-path"] },
        "identity": { "type": "string", "minLength": 1 },
        "token": { "type": "string" },
        "before": { "type": "string" },
        "after": { "type": "string" }
      }
    },
    "sidedDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side", "diagnostic"],
      "properties": {
        "side": { "enum": ["base", "head", "comparison", "backend"] },
        "diagnostic": {
          "type": "object",
          "required": [
            "schemaVersion",
            "code",
            "severity",
            "message",
            "parameters",
            "fingerprint",
            "documentationUrl",
            "related",
            "fixes"
          ],
          "properties": {
            "schemaVersion": { "const": "1" },
            "code": { "type": "string" },
            "severity": { "enum": ["error", "warning", "info"] },
            "message": { "type": "string" },
            "parameters": { "type": "object" },
            "fingerprint": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
            "documentationUrl": { "type": "string", "format": "uri" },
            "related": { "type": "array" },
            "fixes": { "type": "array" }
          }
        }
      }
    }
  }
}
