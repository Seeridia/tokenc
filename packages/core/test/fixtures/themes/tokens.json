{
  "color": {
    "$type": "color",
    "base": {
      "$value": "#ffffff",
      "$extensions": {
        "org.token-compiler.contexts": {
          "theme=dark": { "$value": "#111111" },
          "brand=enterprise": { "$value": "#0052d9" },
          "theme=dark&brand=enterprise": { "$value": "#003cab" }
        }
      }
    },
    "page": { "$value": "{color.base}" }
  }
}
