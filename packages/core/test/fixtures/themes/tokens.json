{
  "color": {
    "$type": "color",
    "base": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "alpha": 1,
        "hex": "#ffffff"
      },
      "$extensions": {
        "org.token-compiler.contexts": {
          "theme=dark": {
            "$value": {
              "colorSpace": "srgb",
              "components": [0.0666666667, 0.0666666667, 0.0666666667],
              "alpha": 1,
              "hex": "#111111"
            }
          },
          "brand=enterprise": {
            "$value": {
              "colorSpace": "srgb",
              "components": [0, 0.3215686275, 0.8509803922],
              "alpha": 1,
              "hex": "#0052d9"
            }
          },
          "theme=dark&brand=enterprise": {
            "$value": {
              "colorSpace": "srgb",
              "components": [0, 0.2352941176, 0.6705882353],
              "alpha": 1,
              "hex": "#003cab"
            }
          }
        }
      }
    },
    "page": { "$value": "{color.base}" }
  }
}
