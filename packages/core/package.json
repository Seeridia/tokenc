{
  "name": "@tokenc/core",
  "version": "0.1.1",
  "description": "DTCG-native, typed, graph-based Design Token compiler core",
  "keywords": [
    "compiler",
    "design-system",
    "design-tokens",
    "dtcg"
  ],
  "homepage": "https://github.com/Seeridia/tokenc#readme",
  "bugs": {
    "url": "https://github.com/Seeridia/tokenc/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Seeridia/tokenc.git",
    "directory": "packages/core"
  },
  "files": [
