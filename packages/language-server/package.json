{
  "name": "@tokenc/language-server",
  "version": "0.6.0",
  "description": "Language Server Protocol adapter for the tokenc Design Token compiler",
  "keywords": [
    "design-tokens",
    "dtcg",
    "language-server",
    "lsp"
  ],
  "homepage": "https://github.com/Seeridia/tokenc#readme",
  "bugs": {
    "url": "https://github.com/Seeridia/tokenc/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Seeridia/tokenc.git",
    "directory": "packages/language-server"
  },
  "bin": {
    "tokenc-language-server": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp run build"
  },
  "dependencies": {
    "@tokenc/cli": "workspace:*",
    "@tokenc/core": "workspace:*",
    "micromatch": "4.0.8",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.11"
  },
  "devDependencies": {
    "@types/micromatch": "4.0.10",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
