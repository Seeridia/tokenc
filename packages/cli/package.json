{
  "name": "@tokenc/cli",
  "version": "0.1.0",
  "description": "Command-line interface for the tokenc Design Token compiler",
  "keywords": [
    "cli",
    "compiler",
    "design-tokens",
    "dtcg"
  ],
  "license": "MIT",
  "bin": {
    "tokenc": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --clean --external @tokenc/core --external @tokenc/backend-css --external @tokenc/backend-tailwind --external @tokenc/backend-typescript",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tokenc/backend-css": "workspace:*",
    "@tokenc/backend-tailwind": "workspace:*",
    "@tokenc/backend-typescript": "workspace:*",
    "@tokenc/core": "workspace:*",
    "chokidar": "^4.0.3",
    "jiti": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
