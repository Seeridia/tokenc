{
  "name": "@tokenc/cli",
  "version": "0.6.0",
  "description": "Command-line interface for the tokenc Design Token compiler",
  "keywords": [
    "cli",
    "compiler",
    "design-tokens",
    "dtcg"
  ],
  "homepage": "https://github.com/Seeridia/tokenc#readme",
  "bugs": {
    "url": "https://github.com/Seeridia/tokenc/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Seeridia/tokenc.git",
    "directory": "packages/cli"
  },
  "bin": {
    "tokenc": "./dist/bin.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./report-v1.schema.json": "./schema/report-v1.schema.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp run build"
  },
  "dependencies": {
    "@tokenc/backend-css": "workspace:*",
    "@tokenc/backend-tailwind": "workspace:*",
    "@tokenc/backend-typescript": "workspace:*",
    "@tokenc/core": "workspace:*",
    "chokidar": "^5.0.0",
    "jiti": "^2.5.0",
    "micromatch": "^4.0.8"
  },
  "devDependencies": {
    "@types/micromatch": "^4.0.10",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
