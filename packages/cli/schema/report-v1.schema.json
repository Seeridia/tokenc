{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokenc.dev/schemas/report-v1.schema.json",
  "title": "tokenc Report v1",
  "description": "Shared immutable report envelope rendered as text, JSON, or SARIF 2.1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "verdict", "data", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "command": { "enum": ["check", "diff"] },
    "verdict": { "enum": ["pass", "fail", "incomplete"] },
    "data": {
      "oneOf": [{ "$ref": "#/$defs/checkData" }, { "$ref": "#/$defs/diffData" }]
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/reportDiagnostic" }
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "column", "offset", "length"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "offset": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 0 }
      }
    },
    "location": {
      "type": "object",
      "required": ["document", "range"],
      "properties": {
        "document": { "type": "string" },
        "range": { "$ref": "#/$defs/range" }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "schemaVersion",
        "code",
        "severity",
        "message",
        "parameters",
        "fingerprint",
        "documentationUrl",
        "related",
        "fixes"
      ],
      "properties": {
        "schemaVersion": { "const": "1" },
        "code": { "type": "string" },
        "severity": { "enum": ["error", "warning", "info"] },
        "message": { "type": "string" },
        "parameters": { "type": "object" },
        "fingerprint": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "documentationUrl": { "type": "string" },
        "source": { "$ref": "#/$defs/location" },
        "related": { "type": "array" },
        "fixes": { "type": "array" }
      }
    },
    "reportDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "allowed", "diagnostic"],
      "properties": {
        "origin": { "enum": ["compiler", "comparison", "policy"] },
        "side": { "enum": ["base", "head", "comparison", "backend"] },
        "allowed": { "type": "boolean" },
        "findingId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "ruleId": { "type": "string" },
        "changeId": { "type": "string" },
        "allowReason": { "type": "string" },
        "diagnostic": { "$ref": "#/$defs/diagnostic" }
      }
    },
    "checkData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "tokens", "references"],
      "properties": {
        "kind": { "const": "check" },
        "tokens": { "type": "integer", "minimum": 0 },
        "references": { "type": "integer", "minimum": 0 }
      }
    },
    "diffData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "comparison"],
      "properties": {
        "kind": { "const": "diff" },
        "comparison": { "type": "object" },
        "policy": { "type": "object" }
      }
    }
  }
}
