{
  "name": "@tokenc/backend-tailwind",
  "version": "0.1.0",
  "description": "Tailwind CSS v4 backend for the tokenc Design Token compiler",
  "keywords": [
    "compiler",
    "design-tokens",
    "dtcg",
    "tailwindcss"
  ],
  "homepage": "https://github.com/Seeridia/tokenc#readme",
  "bugs": {
    "url": "https://github.com/Seeridia/tokenc/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Seeridia/tokenc.git",
    "directory": "packages/backend-tailwind"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external @tokenc/core",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tokenc/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
