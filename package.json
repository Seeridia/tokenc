{
  "name": "tokenc",
  "version": "0.1.0",
  "private": true,
  "description": "A typed, graph-based compiler for DTCG Design Tokens",
  "homepage": "https://github.com/Seeridia/tokenc#readme",
  "bugs": {
    "url": "https://github.com/Seeridia/tokenc/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Seeridia/tokenc.git"
  },
  "type": "module",
  "scripts": {
    "bench": "vp exec tsx benchmarks/compiler.bench.ts",
    "build": "vp run -r build",
    "changeset": "changeset",
    "check": "vp check",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix .",
    "publish-packages": "node scripts/publish-packages.mjs",
    "release": "vp run verify && vp run publish-packages",
    "test": "vp test --run",
    "test:watch": "vp test",
    "typecheck": "vp check --no-fmt --no-lint",
    "tokenc": "tsx packages/cli/src/bin.ts",
    "verify": "vp check && vp run -r build && vp test --run",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.16.0"
}
