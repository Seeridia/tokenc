{
  "name": "tokenc",
  "version": "0.1.0",
  "private": true,
  "description": "A typed, graph-based compiler for DTCG Design Tokens",
  "homepage": "https://github.com/Seeridia/tokenc#readme",
  "bugs": {
    "url": "https://github.com/Seeridia/tokenc/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Seeridia/tokenc.git"
  },
  "type": "module",
  "scripts": {
    "bench": "vp exec tsx benchmarks/compiler.bench.ts",
    "bench:gate": "vp exec tsx benchmarks/performance-gate.ts",
    "bench:m2:gate": "vp exec tsx benchmarks/m2-performance-gate.ts",
    "build": "vp run -r build",
    "changeset": "changeset",
    "check": "vp check",
    "check:contracts": "node scripts/check-public-contracts.mjs",
    "check:versions": "node scripts/check-package-versions.mjs",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix .",
    "publish-packages": "node scripts/publish-packages.mjs",
    "test": "vp test --run",
    "test:watch": "vp test",
    "typecheck": "vp check --no-fmt --no-lint",
    "tokenc": "tsx packages/cli/src/bin.ts",
    "verify": "vp run check:versions && vp check && vp run -r build && vp run check:contracts && vp test --run && vp run bench:gate && vp run bench:m2:gate",
    "verify-release": "node scripts/verify-release.mjs",
    "version-packages": "changeset version && vp run check:versions"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "^24.0.0",
    "dtcg-examples": "1.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.16.0"
}
