{
  "name": "tokenc",
  "version": "0.1.0",
  "private": true,
  "description": "A DTCG-native, typed, graph-based Design Token compiler",
  "homepage": "https://github.com/Seeridia/tokenc#readme",
  "bugs": {
    "url": "https://github.com/Seeridia/tokenc/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Seeridia/tokenc.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "publish-packages": "node scripts/publish-packages.mjs",
    "release": "pnpm check && pnpm publish-packages",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "tokenc": "tsx packages/cli/src/bin.ts",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^24.0.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.16.0"
}
